<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialWebIntelligence.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialWebIntelligence.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <!-- Main sidebar: navigation between the platform's major modules. -->
        <aside class="app-sidebar">
            <a class="sidebar-brand"
               asp-controller="Dashboard"
               asp-action="Index">
                <span class="brand-mark">SW</span>
                <span>
                    <strong>SocialWeb</strong>
                    <small>INTELLIGENCE</small>
                </span>
            </a>

            <div class="sidebar-section-label">WORKSPACE</div>

            <nav class="sidebar-nav">
                <a class="sidebar-link"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <span class="sidebar-icon">▦</span>
                    Dashboard
                </a>

                <a class="sidebar-link"
                   asp-controller="Sources"
                   asp-action="Index">
                    <span class="sidebar-icon">◎</span>
                    Monitored Sources
                </a>
            </nav>

            <div class="sidebar-section-label">INTELLIGENCE</div>

            <nav class="sidebar-nav">
                <a class="sidebar-link"
                   asp-controller="Sources"
                   asp-action="Index">
                    <span class="sidebar-icon">⌕</span>
                    Website Intelligence
                </a>

                <a class="sidebar-link disabled-link"
                   href="#"
                   aria-disabled="true">
                    <span class="sidebar-icon">◉</span>
                    Social Media Intelligence
                    <span class="coming-soon">Soon</span>
                </a>
            </nav>

            <div class="sidebar-section-label">MANAGEMENT</div>

            <nav class="sidebar-nav">
                <a class="sidebar-link disabled-link"
                   href="#"
                   aria-disabled="true">
                    <span class="sidebar-icon">▤</span>
                    Reports
                    <span class="coming-soon">Soon</span>
                </a>

                <a class="sidebar-link disabled-link"
                   href="#"
                   aria-disabled="true">
                    <span class="sidebar-icon">♧</span>
                    Alerts
                    <span class="coming-soon">Soon</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-status">
                    <span class="status-dot"></span>
                    Platform workspace
                </div>
                <small>SocialWebIntelligence · 2026</small>
            </div>
        </aside>

        <!-- Main content area: individual MVC views render inside this workspace. -->
        <div class="app-main">
            <header class="topbar">
                <div>
                    <div class="topbar-eyebrow">SOCIALWEBINTELLIGENCE</div>
                    <div class="topbar-title">@ViewData["Title"]</div>
                </div>

                <div class="topbar-right">
                    <span class="environment-label">Website Intelligence</span>
                    <div class="user-avatar">SW</div>
                </div>
            </header>

            <main role="main" class="dashboard-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                SocialWebIntelligence · Company Intelligence Workspace
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

</html>
