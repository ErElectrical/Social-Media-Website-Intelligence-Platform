@model SocialWebIntelligence.Core.Entities.MonitoredSource

@{
    ViewData["Title"] = "Add Source";
}

<h2>Add New Source</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CompanyName"
               class="form-label">Company Name</label>

        <input asp-for="CompanyName"
               class="form-control"
               placeholder="Enter company name" />

        <span asp-validation-for="CompanyName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Platform"
               class="form-label">Platform</label>

        <select asp-for="Platform"
                asp-items="Html.GetEnumSelectList<SocialWebIntelligence.Core.Entities.SourcePlatform>()"
                class="form-select">
            <option value="">Select Platform</option>
        </select>

        <span asp-validation-for="Platform"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Url"
               class="form-label">Source URL</label>

        <input asp-for="Url"
               class="form-control"
               placeholder="https://example.com" />

        <span asp-validation-for="Url"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Source
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
